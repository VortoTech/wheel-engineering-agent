FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/services

WORKDIR /app

# OCC/CadQuery wheels need the OpenGL/X11 runtime libraries even for headless STEP export.
ARG APT_MIRROR=deb.debian.org
RUN sed -i "s|http://deb.debian.org|https://${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources && \
    apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 libxrender1 libsm6 && \
    rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY services ./services
COPY scripts ./scripts
COPY experiments/real-orders ./experiments/real-orders
COPY experiments/forged-blank/recipes ./experiments/forged-blank/recipes

ARG PIP_INDEX_URL=https://pypi.org/simple
RUN pip install --isolated --no-cache-dir --index-url "$PIP_INDEX_URL" '.[test]'

CMD ["python", "-m", "wheelcam.workbench", "--runs", "/output", "--port", "8790"]
